{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm ci --prefix apps/portfolio && npm run build --prefix apps/portfolio",
    "deploy": "node scripts/cloudflare-pages-deploy.mjs",
    "dev": "npm run dev --prefix apps/portfolio",
    "supabase:deploy": "node scripts/supabase-deploy.mjs --project all",
    "supabase:validate": "node scripts/supabase-deploy.mjs --validate-only --project all"
  },
  "engines": {
    "node": ">=20"
  }
}
