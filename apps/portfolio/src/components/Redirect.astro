---
interface Props {
  to: string;
}

const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={`https://connorjpepin.com${to.startsWith("/#") ? to : to}`} />
    <title>Redirecting…</title>
    <script is:inline define:vars={{ to }}>
      location.replace(to);
    </script>
  </head>
  <body>
    <p>
      <a href={to}>Continue to {to}</a>
    </p>
  </body>
</html>
