---
import { profile } from "../../data/profile";

interface Props {
  currentSection?: string;
}

const { currentSection = "overview" } = Astro.props;
---

<aside class="relative z-20 hidden w-11 shrink-0 self-stretch border-r border-swagger-border bg-swagger-bg/95 md:block">
  <nav class="sticky top-14 flex max-h-[calc(100vh-3.5rem)] flex-col items-center gap-1 overflow-visible py-4" aria-label="Documentation sections">
    <ul class="flex flex-col items-center gap-1">
      {
        profile.navigation.map((item) => {
          const active = currentSection === item.id;
          const shortTag =
            item.tag === "info"
              ? "inf"
              : item.tag === "paths"
                ? "pth"
                : item.tag === "gallery"
                  ? "gal"
                  : item.tag === "document"
                    ? "doc"
                    : "pst";
          return (
            <li class="group relative">
              <a
                href={`/#${item.id}`}
                class:list={[
                  "relative flex h-9 w-9 items-center justify-center rounded font-mono text-[10px] font-medium uppercase tracking-tight transition-all duration-200",
                  active
                    ? "bg-swagger-code font-medium text-swagger-get shadow-sm"
                    : "text-swagger-muted hover:bg-swagger-panel hover:text-swagger-text",
                ]}
                aria-label={item.label}
                aria-current={active ? "page" : undefined}
              >
                {active && (
                  <span class="absolute -left-px top-1/2 h-5 w-0.5 -translate-y-1/2 rounded-r bg-swagger-get" aria-hidden="true" />
                )}
                {shortTag}
              </a>
              <div
                role="tooltip"
                class="pointer-events-none absolute left-[calc(100%+0.5rem)] top-1/2 z-30 -translate-y-1/2 translate-x-1 opacity-0 transition-all duration-200 ease-out group-hover:translate-x-0 group-hover:opacity-100 group-focus-within:translate-x-0 group-focus-within:opacity-100"
              >
                <div class="whitespace-nowrap rounded border border-swagger-border bg-swagger-panel px-2.5 py-1.5 text-sm font-medium text-swagger-text shadow-lg">
                  {item.label}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>
