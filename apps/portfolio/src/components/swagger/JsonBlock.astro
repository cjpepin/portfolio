---
interface Props {
  data: Record<string, unknown> | readonly unknown[];
  title?: string;
}

const { data, title } = Astro.props;
const json = JSON.stringify(data, null, 2);
---

<div class="swagger-panel overflow-hidden">
  {title && (
    <div class="border-b border-swagger-border px-4 py-2 font-mono text-xs uppercase tracking-wide text-swagger-muted">
      {title}
    </div>
  )}
  <pre class="overflow-x-auto p-4 font-mono text-sm leading-relaxed text-swagger-text"><code>{json}</code></pre>
</div>
