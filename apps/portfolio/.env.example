# Cloudflare Pages deploy (CI only — set in Dashboard → Environment variables)
# CF_PAGES_PROJECT_NAME=your-pages-project-slug

# LingoLeaf web build-time (required for npm run sync:lingoleaf-web locally and in CI)
# sync-lingoleaf-web.sh loads this file automatically; SUPABASE_* aliases also work.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_DB_SCHEMA=lingoleaf
# VITE_TURNSTILE_SITE_KEY=

# Optional: override lingoleaf-web source when projects/ is not checked out locally
# LINGOLEAF_WEB_REPO=https://github.com/cjpepin/lingoleaf-web.git
# LINGOLEAF_WEB_REF=main

# LingoLeaf web server-only (Pages Functions at /lingoleaf/api/*)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET_KEY=

RESEND_API_KEY=
CONTACT_TO_EMAIL=cjpepin@wustl.edu
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
CONTACT_RATE_LIMIT_PER_15MIN=5

# Demo API (Cloudflare Pages Functions)
GOOGLE_TRANSLATE_API_KEY=
OPENAI_API_KEY=
DEMO_ALLOWED_ORIGINS=http://localhost:4321,https://connorjpepin.com,https://www.connorjpepin.com
DEMO_RATE_LIMIT_PER_HOUR=30
